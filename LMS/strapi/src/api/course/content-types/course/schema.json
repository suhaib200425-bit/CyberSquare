{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "text"
    },
    "FullDescription": {
      "type": "blocks"
    },
    "Level": {
      "type": "enumeration",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced",
        "All Levels"
      ]
    },
    "Duration": {
      "type": "string"
    },
    "Lessons": {
      "type": "integer"
    },
    "Rating": {
      "type": "decimal"
    },
    "Reviews": {
      "type": "integer"
    },
    "Student": {
      "type": "integer"
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "price": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::price.price",
      "mappedBy": "course"
    },
    "Auther": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "courses"
    },
    "sections": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::section.section",
      "mappedBy": "course"
    }
  }
}
